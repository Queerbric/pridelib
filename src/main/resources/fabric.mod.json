{
	"schemaVersion": 1,
	"id": "pride",
	"version": "${version}",
	"name": "Pride Lib",
	"description": "A unified library for data-driven flags.",
	"authors": [
		"Emi"
	],
	"contributors": [
		"unascribed",
		"LambdAurora"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/pride/icon.png",
	"environment": "client",
	"entrypoints": {
		"yumi:client_init": [
			"io.github.queerbric.pride.impl.PrideClientInitializer"
		],
		"pride:platform_provider": [
			"io.github.queerbric.pride.impl.platform.fabric.FabricPlatform"
		]
	},
	"accessWidener": "pride.accesswidener",
	"depends": {
		"minecraft": "~1.21.11-",
		"fabricloader": ">=0.18.1",
		"yumi_mc_core": ">=1.0.0-beta.1+1.21.11",
		"fabric-resource-loader-v1": "*"
	},
	"custom": {
		"modmenu": {
			"badges": [
				"library"
			]
		}
	}
}
